# =============================================================================
# Bank Management System — .gitignore
# =============================================================================

# --- Environment & Secrets (NEVER commit these) ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyc
*.pyd

# --- Virtual Environments ---
.venv/
venv/
env/
ENV/
.virtualenv/

# --- Distribution / Build ---
dist/
build/
*.egg-info/
*.egg
*.whl
MANIFEST

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
*.xml

# --- Logs ---
logs/
*.log

# --- Exports (generated at runtime, too large for git) ---
exports/
statements/
reports/

# --- IDEs ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Database dumps ---
*.sql.bak
*.dump

# --- Jupyter Notebooks checkpoints ---
.ipynb_checkpoints/

# --- Temporary files ---
*.tmp
*.bak
*.swp
*~
